    <string name="onboarding_welcome_title">Welcome to NoveLauncher</string>
    <string name="onboarding_welcome_desc">A smart launcher that learns your habits and organises your phone for you with AI.\n\nEverything runs on-device — your privacy is protected.</string>
    <string name="onboarding_usage_title">Usage permission</string>
    <string name="onboarding_usage_desc">To learn your habits, NoveLauncher needs access to usage data.\n\nTap below to enable.</string>
    <string name="onboarding_usage_action">Enable permission</string>
    <string name="onboarding_gestures_title">Gestures</string>
    <string name="onboarding_gestures_desc">• Swipe left/right between pages\n• Swipe up for the app drawer\n• Long-press an app to move or hide\n• Tap the clock for quick edit</string>
    <string name="onboarding_personalize_title">Personalise</string>
    <string name="onboarding_personalize_desc">In settings you\'ll find:\n• Themes and colours\n• Fonts and icon shapes\n• Wallpapers and clock\n• Security and locking\n• Automatic backup\n\nEverything is changeable at any time!</string>
    <string name="onboarding_default_title">Set as default launcher</string>
    <string name="onboarding_default_desc">So NoveLauncher appears every time you return home, set it as your default.</string>
    <string name="onboarding_default_action">Set as default</string>
