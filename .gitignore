# Built application files
*.apk
*.aab
*.ap_
*.aar

# Exception: old debug builds kept deliberately for reference — see
# assets/archive/README.md for what's here and why (not the current release).
!assets/archive/old-releases/*.apk

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle
.gradle/
build/
**/build/
local.properties

# Kotlin compiler daemon incremental-compilation cache
.kotlin/

# v9.3: Robolectric's default Context.cacheDir resolves relative to the test
# worker's CWD (android/app/), not a real Android cache dir — IconCacheTest's
# disk-persistence tests leave real PNG files here after a local test run.
android/app/icon_cache/

# Android Studio / IntelliJ
*.iml
.idea/
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
captures/
.externalNativeBuild/
.cxx/

# Keystore files
*.jks
*.keystore
key.properties

# Exception: the debug keystore IS committed on purpose (see build.gradle.kts).
# It's a throwaway debug-only key (well-known password "android", same as AGP's
# own auto-generated default) — checking it in gives every machine and every CI
# run the same debug signature, so debug APK updates install cleanly instead of
# colliding with whatever random key the last build happened to generate.
!android/app/debug.keystore

# Google Services / OAuth secrets
google-services.json
GoogleService-Info.plist

# OS-specific
.DS_Store
Thumbs.db

# Logs
*.log

# Python (for assets/generate_graphics.py)
__pycache__/
*.pyc
.venv/
