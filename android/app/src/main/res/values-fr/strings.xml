    <string name="onboarding_welcome_title">Bienvenue dans NoveLauncher</string>
    <string name="onboarding_welcome_desc">Un lanceur intelligent qui apprend vos habitudes et organise votre téléphone pour vous grâce à l\'IA.\n\nTout se passe sur l\'appareil — votre vie privée est protégée.</string>
    <string name="onboarding_usage_title">Autorisation d\'usage</string>
    <string name="onboarding_usage_desc">Pour apprendre vos habitudes, NoveLauncher a besoin d\'accéder aux données d\'usage.\n\nAppuyez ci-dessous pour activer.</string>
