    <string name="onboarding_welcome_title">Bienvenido a NoveLauncher</string>
    <string name="onboarding_welcome_desc">Un launcher inteligente que aprende tus hábitos y organiza tu teléfono por ti con IA.\n\nTodo funciona en el dispositivo — tu privacidad está protegida.</string>
    <string name="onboarding_usage_title">Permiso de uso</string>
    <string name="onboarding_usage_desc">Para aprender tus hábitos, NoveLauncher necesita acceso a los datos de uso.\n\nToca abajo para activarlo.</string>
    <string name="onboarding_usage_action">Activar permiso</string>
    <string name="onboarding_gestures_title">Gestos</string>
    <string name="onboarding_gestures_desc">• Desliza izquierda/derecha entre páginas\n• Desliza hacia arriba para el cajón de apps\n• Mantén pulsada una app para moverla u ocultarla\n• Toca el reloj para edición rápida</string>
    <string name="onboarding_personalize_title">Personaliza</string>
    <string name="onboarding_personalize_desc">En ajustes encontrarás:\n• Temas y colores\n• Fuentes y formas de icono\n• Fondos de pantalla y reloj\n• Seguridad y bloqueo\n• Copia de seguridad automática\n\n¡Todo se puede cambiar en cualquier momento!</string>
    <string name="onboarding_default_title">Establecer como launcher predeterminado</string>
    <string name="onboarding_default_desc">Para que NoveLauncher aparezca cada vez que vuelvas al inicio, establécelo como predeterminado.</string>
    <string name="onboarding_default_action">Establecer como predeterminado</string>
